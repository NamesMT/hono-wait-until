{
  "name": "hono-wait-until",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@12.4.1",
  "description": "",
  "author": "NamesMT <dangquoctrung123@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/namesmt",
  "homepage": "https://github.com/namesmt/hono-wait-until#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namesmt/hono-wait-until.git"
  },
  "bugs": "https://github.com/namesmt/hono-wait-until/issues",
  "keywords": [],
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "source": "./src/index.ts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=dev tsx src/index.ts",
    "watch": "NODE_ENV=dev tsx watch src/index.ts",
    "dev": "pnpm run watch",
    "lint": "eslint .",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "check": "pnpm lint && pnpm test:types && vitest run --coverage",
    "build": "tsdown",
    "release": "pnpm dlx changelogen@latest --release --push --publish",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "hono": ">=4.13.7"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": false
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@namesmt/utils": "^0.5.18",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.36.0",
    "hono": "^4.13.7",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.14.0",
    "std-env": "^3.10.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
